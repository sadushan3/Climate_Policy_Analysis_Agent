# ---- service ----
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- auth (REQUIRED in production) ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# In dev an ephemeral secret is generated at startup; in prod the app refuses to
# boot without one, because a default secret means anyone can mint valid tokens.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
ALLOW_REGISTRATION=true
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=300

# ---- optional LLM layer ----
# Everything works without this. Setting it enables grounded Q&A, abstractive
# summaries and the written comparison narrative.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high

# ---- tuning (defaults are the measured optimum; see eval/run_eval.py) ----
DIMENSION_THRESHOLD=0.46
CHUNK_TARGET_TOKENS=320
RERANK_TOP_K=8
ENABLE_RERANKER=true
